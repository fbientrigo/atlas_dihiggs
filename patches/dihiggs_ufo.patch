+      - repository: fbientrigo/dihiggs_hep_cross
+        path: docs/CURRENT_DATA_AUTHORITY.md
+        kind: documentation
+        action: separate_data_authority_from_v3_physics_authority
+      - repository: fbientrigo/dihiggs_hep_cross
+        path: tests/test_constants.py
