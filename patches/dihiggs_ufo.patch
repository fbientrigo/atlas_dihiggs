+      - repository: fbientrigo/dihiggs_hep_cross
+        path: conventions/physics_conventions.yaml
+        kind: controlled_cache
+        action: replace_with_byte_identical_v3_cache_and_provenance_sidecar
+      - repository: fbientrigo/dihiggs_hep_cross
+        path: src/llp_recast/constants.py
+        kind: active_code_default
+        action: replace_pinned_text_and_v3_loader_path
+      - repository: fbientrigo/dihiggs_hep_cross
+        path: scripts/run_mass_jet_control_campaign.py
+        kind: active_campaign_script
+        action: parameterize_or_adopt_active_v3_mass_with_explicit_provenance
+      - repository: fbientrigo/dihiggs_hep_cross
+        path: state/CURRENT_CAMPAIGN.yaml
+        kind: current_campaign_state
+        action: classify_as_frozen_125p20_campaign_or_regenerate_as_a_new_125p13_campaign
+      - repository: fbientrigo/dihiggs_hep_cross
+        path: docs/MH_CONVENTION.md
+        kind: documentation
