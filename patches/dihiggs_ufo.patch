+# Project-wide physics authority for the active DiHiggs repository family.
+#
+# `fbientrigo/dihiggs` owns this file. A downstream copy is a controlled cache,
+# never an independent authority; see `migration.downstream_copy` below.
+schema_version: physics_conventions_v3
+
+authority:
+  status: active
+  repository: fbientrigo/dihiggs
+  path: conventions/physics_conventions.yaml
+  human_contract: docs/PROJECT_PHYSICS_AUTHORITY.md
+  discrepancy_ledger: docs/PHYSICS_AUTHORITY_DISCREPANCY_LEDGER.md
+  adopted_utc: "2026-09-07"
+  decision_issue: https://github.com/fbientrigo/dihiggs/issues/83
+  scope: active new production and cross-repository handoffs
+
+constants:
+  # c*tau[mm] = hbar_c_gev_mm / Gamma[GeV]
+  hbar_c_gev_mm: 1.973269804e-13
+  # c*tau[mm] = c_mm_per_ns * tau[ns]
+  c_mm_per_ns: 299.792458
+
+mass_conventions:
+  active:
+    id: mh_125p20_active_2026
+    state: h
+    value_GeV: "125.20"
+    serialization: decimal_string
+    status: active_new_production
+    authority_kind: project_convention
+    decision_issue: https://github.com/fbientrigo/dihiggs/issues/83
+    source_label: corrected project convention
+    source_url: https://github.com/fbientrigo/dihiggs/issues/83
+    note: >-
+      Corrected project convention for new production. It is deliberately
+      distinct from external-measurement values and is serialized exactly.
+  historical:
+    - id: mh_125p13_pdg_2026_historical_replay
+      value_GeV: "125.13"
+      status: historical_replay_only
+      new_production_allowed: false
+      preserve_for_replay: true
+      scope: >-
+        Completed adaptive M2 boundary campaign and explicit regression
+        fixtures. It must never seed a new production run.
+    - id: mh_125p13_high_mass_v1
+      value_GeV: "125.13"
+      status: historical
+      new_production_allowed: false
+      preserve_for_replay: true
+      scope: high-mass campaign v1, 150 GeV benchmark chain, point-v2 verification v1
+    - id: mh_125p09_lambda1_boundary_legacy
+      value_GeV: "125.09"
+      status: historical
+      new_production_allowed: false
+      preserve_for_replay: true
+      scope: lambda1 characterization and legacy boundary input
+    - id: mh_125p0_ufo_autoresearch_legacy
+      value_GeV: "125.0"
+      status: historical
+      new_production_allowed: false
+      preserve_for_replay: true
+      scope: upstream UFO default and replay-only legacy/autoresearch paths
+
+states:
+  h:
+    canonical_symbol: h
+    role: SM-like CP-even scalar
+    pdg_id: 25
+    mass_field: m_h_GeV
+    accepted_aliases: [h_SM]
+  phi:
+    canonical_symbol: phi
+    role: additional CP-even scalar and LLP candidate
+    pdg_id: 35
+    mass_field: m_phi_GeV
+    accepted_aliases: [H2]
+    legacy_mass_fields: [mH, mH_input_GeV, mH2_GeV]
+    forbidden_unqualified_aliases: [H]
+  A:
+    canonical_symbol: A
+    role: CP-odd scalar
+    pdg_id: 36
+    mass_field: mA_GeV
+  H_plus:
+    canonical_symbol: H+
+    role: charged scalar
+    pdg_id: 37
+    antiparticle_symbol: H-
+    antiparticle_pdg_id: -37
+    mass_field: mHp_GeV
+
+model:
+  family: general_2HDM
+  cp_conserving: true
+  scalar_potential_basis: generic_Phi1_Phi2
+  yukawa:
+    assignment: Type-I
+    type_code: 1
+    fixed_basis: true
+    fermion_coupling_doublet: Phi2
+    phi2_couples_to: [up_type_quarks, down_type_quarks, charged_leptons]
+    tan_beta:
+      definition: v2/v1
+      basis_dependent: true
+      meaningful_only_in_fixed_yukawa_basis: true
+  z2_breaking:
+    soft_coefficients: [m12_sq]
+    hard_coefficients: [lambda6, lambda7]
+    rule: nonzero lambda6 or lambda7 is hard Z2 breaking
+
+campaign_choices:
+  must_be_explicit_in_new_manifest: true
+  authority_supplies_no_default: true
+  exact_alignment:
+    expression: sin(beta-alpha) = 1
+    status: campaign_choice
+  lambda7_zero:
+    expression: lambda7 = 0
+    status: campaign_choice
+  neutral_charged_degeneracy:
+    expression: mA = mHp
+    status: campaign_choice
+
+parameters:
+  M2:
+    symbol: M^2
+    unit: GeV^2
+    definition: m12_sq/(sin(beta)*cos(beta))
+    basis: fixed Type-I generic basis
+    distinct_from: [m12_sq, m22_sq]
+  m12_sq:
+    symbol: m12^2
+    unit: GeV^2
+    definition: M2*sin(beta)*cos(beta)
+    potential_role: off-diagonal quadratic coefficient
+    z2_breaking: soft
+    distinct_from: [M2, m22_sq]
+  m22_sq:
+    symbol: m22^2
+    unit: GeV^2
+    definition: coefficient of Phi2^dagger*Phi2 in the declared generic-basis potential
+    potential_role: diagonal quadratic coefficient
+    distinct_from: [M2, m12_sq]
+
+trilinear_prescriptions:
+  physical_2HDM:
+    label: physical 2HDM trilinear
+    category: model_derived
+    source_repository: fbientrigo/dihiggs
+    source_calculator: 2HDMC
+    source_call: get_coupling_hhh(1,2,2,c)
+    raw_complex_fields:
+      real: two_hdmc_hphiphi_real_GeV
+      imaginary: two_hdmc_hphiphi_imag_GeV
+    signed_field: g_physical_hphiphi_GeV
+    magnitude_field: g_physical_hphiphi_abs_GeV
+    current_compatibility_field: g_hH2H2_GeV
+    current_compatibility_semantics: absolute_magnitude
+    compatibility_relation: g_hH2H2_GeV = g_physical_hphiphi_abs_GeV
+    potential_term: V contains +(g_physical_hphiphi_GeV/2!)*h*phi^2
+    interaction_term: L_int=-V contains -(g_physical_hphiphi_GeV/2!)*h*phi^2
+    identical_phi_symmetry_factor: "2!"
+    two_hdmc_return: c = -i*g_physical_hphiphi_GeV
+    feynman_rule: -i*g_physical_hphiphi_GeV
+    ufo_parameter_mapping: GH1H2H2 = -i*c = two_hdmc_hphiphi_imag_GeV = -g_physical_hphiphi_GeV
+    ufo_vertex_convention: +i*GH1H2H2
+    signed_export_status: resolved
+    sign_sensitive_use: g_physical_hphiphi_GeV
+    invalid_output_action: reject
+    convention_unknown_when: nonzero real component for the declared CP-conserving convention
+    resolution_issue: https://github.com/fbientrigo/dihiggs/issues/85
+  effective_mass_only:
+    label: project effective mass-only prescription
+    category: project_defined_effective
+    output_quantity: g_effective_hphiphi_GeV
+    formula: 8*m_phi^2/v
+    unit: GeV
+    required_inputs: [m_phi_GeV, v_GeV]
+    ufo_vertex_mapping_status: unresolved
+    sign_sensitive_use: fail_closed
+    not_a_general_2HDM_identity: true
+  effective_m22_shifted:
+    label: project effective m22-shifted prescription
+    category: project_defined_effective
+    output_quantity: g_effective_hphiphi_GeV
+    formula: 8*(m_phi^2-m22_sq)/v
+    unit: GeV
+    required_inputs: [m_phi_GeV, m22_sq_GeV2, v_GeV]
+    m22_basis_requirement: declared generic_Phi1_Phi2 basis
+    ufo_vertex_mapping_status: unresolved
+    sign_sensitive_use: fail_closed
+    not_a_general_2HDM_identity: true
+
+stage_ownership:
+  dihiggs:
+    repository: fbientrigo/dihiggs
+    owns: [model_points, theory_predicates, masses, potential_parameters, widths, branching_ratios, proper_lifetime]
+    does_not_own: [UFO_implementation, MadGraph_cross_sections, recast_efficiency, composed_limits]
+  dihiggs_ufo:
+    repository: fbientrigo/dihiggs_ufo
+    owns: [UFO_model_implementation, parameter_and_vertex_mapping, model_pack_validation]
+    does_not_own: [model_point_authority, MadGraph_cross_sections, recast_efficiency, composed_limits]
+  dihiggs_hep_cross:
+    repository: fbientrigo/dihiggs_hep_cross
+    owns: [MadGraph_execution, cross_sections, generator_cards, production_provenance]
+    does_not_own: [model_point_authority, recast_efficiency, composed_limits]
+  dihiggs_llp_recast:
+    repository: fbientrigo/dihiggs_llp_recast
+    owns: [recast_cutflows, acceptance, efficiency, response_provenance]
+    does_not_own: [model_point_authority, production_cross_sections, composed_limits]
+  dihiggs_boundary:
+    repository: fbientrigo/dihiggs_boundary
+    owns: [stage_composition, signal_yields, statistical_limits, boundary_products]
+    does_not_own: [upstream_model_quantities, UFO_implementation, MadGraph_cross_sections, recast_efficiency]
+
+migration:
+  pending_125p20_uses:
+    purpose: >-
+      Historical inventory retained for provenance. The active 125.20
+      convention is not a migration target.
+    required_before_new_production: false
+    discovery_rule: >-
+      Search exact convention token 125.20 in active code, configuration,
+      documentation, and tests. Do not classify unrelated longer numerical
+      values (for example detector geometry coordinates) as Higgs masses.
+    occurrences:
+      - repository: fbientrigo/dihiggs_ufo
+        path: docs/PHYSICAL_POINT_UFO_HANDOFF.md
+        kind: documentation
+        action: replace_false_PDG_attribution_and_link_v3
+      - repository: fbientrigo/dihiggs_ufo
