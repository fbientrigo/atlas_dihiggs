# Allowlist: ignore everything at the root except what is listed here.
# The six module checkouts are submodules (see .gitmodules); local data,
# environments, results, alias symlinks and scratch stay untracked.
/*
!/.gitignore
!/.gitmodules
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/requirements.txt
!/docs/
/docs/audits/*
!/docs/audits/ARCHITECTURE_SIMPLIFICATION_REPORT.md
!/.github/
!/lake/
!/scripts/
!/site/
/site/node_modules/
/site/dist/
/site/.astro/
/site/.cache/
/site/.venv-docs/
/site/src/content/docs/api/
__pycache__/
